# MedQA-RAG Environment Variables
# Copy this file to .env and fill in your values

# ---------------------------------------------------------------------------
# Normal / Baseline Model (Undefended)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=
DEFAULT_MODEL=gpt-4o

NORMAL_API_KEY=your_openai_api_key_here
NORMAL_API_BASE=
NORMAL_MODEL=gpt-4o
NORMAL_TEMPERATURE=0.3
NORMAL_MAX_TOKENS=512
# Anti-repetition penalty for baseline model (e.g. 1.1 - 1.15 safe value for local llama)
NORMAL_REPETITION_PENALTY=1.15

# ---------------------------------------------------------------------------
# Defense Model (StruQ Structured Queries)
# Fine-tuned model hosted on local LAN or custom endpoint
# ---------------------------------------------------------------------------
ENABLE_DEFENSE=true
DEFENSE_API_KEY=x
DEFENSE_API_BASE=http://192.168.33.128:5001/v1/
DEFENSE_MODEL=llama-7b_SpclSpclSpcl_NaiveCompletion_Q8_0
DEFENSE_API_MODE=completions
DEFENSE_TEMPERATURE=0.0
DEFENSE_MAX_TOKENS=512
STRUQ_DELIMITER_STYLE=SpclSpclSpcl
STRUQ_FILTER_DATA=true
DEFENSE_TIMEOUT=300

# ---------------------------------------------------------------------------
# Optional: ChromaDB RAG configuration
# ---------------------------------------------------------------------------
# RAG_PERSIST_DIR=/path/to/MedQA_ChromaDB_Injected
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=100
# RAG_TOP_K=5

# Optional: HuggingFace (for local embeddings)
# USE_HUGGINGFACE=true
# HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# HF_TOKEN=your_huggingface_token_here
